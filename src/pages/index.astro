---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';
import PublicationList from '../components/PublicationList.astro';
import { site } from '../data/site';
import { news } from '../data/news';
import { projects } from '../data/projects';
import { teaching } from '../data/teaching';
import { publications } from '../data/publications';

const validUrl = (url: string) => /^https?:\/\//.test(url);
const updated = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long' }).format(new Date());
const personSchema = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name,
  alternateName: site.nameZh, jobTitle: site.role, email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Taiyuan', addressRegion: 'Shanxi', addressCountry: 'CN' },
  affiliation: [
    { '@type': 'CollegeOrUniversity', name: site.institution },
    { '@type': 'Organization', name: site.laboratory },
  ],
  url: site.canonicalUrl,
  sameAs: Object.values(site.social).filter(validUrl),
  knowsAbout: site.researchInterests,
};
const articleSchema = publications.map((publication) => ({
  '@context': 'https://schema.org', '@type': 'ScholarlyArticle',
  headline: publication.title, datePublished: String(publication.year),
  author: publication.authors.map((name) => ({ '@type': 'Person', name })),
  isPartOf: publication.venue,
}));
---
<BaseLayout>
  <Header />
  <main id="main-content">
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="kicker">{site.role} · {site.institution}</p>
        <h1>{site.name}<span>{site.nameZh}</span></h1>
        <p class="tagline">{site.tagline}</p>
        <p class="affiliation">{site.laboratory}</p>
        <div class="hero-links">
          <a class="primary-link" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
          {validUrl(site.social.scholar) ? <a href={site.social.scholar}><Icon name="scholar" />Scholar</a> : <span class="disabled-link"><Icon name="scholar" />Scholar</span>}
          {validUrl(site.social.github) ? <a href={site.social.github}><Icon name="github" />GitHub</a> : <span class="disabled-link"><Icon name="github" />GitHub</span>}
          {validUrl(site.social.orcid) ? <a href={site.social.orcid}><Icon name="orcid" />ORCID</a> : <span class="disabled-link"><Icon name="orcid" />ORCID</span>}
        </div>
      </div>
      <div class="portrait" role="img" aria-label="Placeholder portrait for Zedong Li">
        <span>ZL</span><small>Replace with portrait</small>
      </div>
    </section>

    <div class="content-shell">
      <Section id="about" eyebrow="Profile" title="About">
        <p class="lead-copy">{site.about}</p>
        <div class="about-grid">
          <div><h3>Research interests</h3><ul class="interest-list">{site.researchInterests.map((item) => <li>{item}</li>)}</ul></div>
          <div><h3>Education</h3>{site.education.map((item) => <div class="timeline-item"><span>{item.period}</span><p><strong>{item.title}</strong><br />{item.organization}</p></div>)}</div>
          <div><h3>Employment</h3>{site.employment.map((item) => <div class="timeline-item"><span>{item.period}</span><p><strong>{item.title}</strong><br />{item.organization}{item.note && <><br /><small>{item.note}</small></>}</p></div>)}</div>
        </div>
      </Section>

      <Section id="news" eyebrow="Updates" title="News">
        <ol class="news-list">{news.map((item) => <li><time>{item.date}</time><p>{item.text}{item.placeholder && <span class="placeholder-label">Placeholder</span>}</p></li>)}</ol>
      </Section>

      <Section id="publications" eyebrow="Research output" title="Selected Publications">
        <p class="section-note">The entries below are clearly marked sample data. Replace them in <code>src/data/publications.ts</code>.</p>
        <PublicationList />
      </Section>

      <Section id="projects" eyebrow="Selected work" title="Projects">
        <div class="project-grid">{projects.map((project) => <article class="project-card"><div class="project-image" aria-hidden="true"><span>{project.title.replace('[Placeholder] ', '').slice(0, 2)}</span></div><div class="project-copy">{project.placeholder && <span class="placeholder-label">Placeholder</span>}<h3>{project.title}</h3><p>{project.description}</p><ul class="tag-list">{project.tags.map((tag) => <li>{tag}</li>)}</ul>{project.links.length > 0 && <div class="card-links">{project.links.map((link) => <a href={link.url}>{link.label}<Icon name="external" size={13} /></a>)}</div>}</div></article>)}</div>
      </Section>

      <Section id="teaching" eyebrow="Academic activities" title="Teaching & Talks">
        <div class="activity-list">{teaching.map((item) => <article><div><span class="activity-type">{item.type}</span><time>{item.date}</time></div><div>{item.placeholder && <span class="placeholder-label">Placeholder</span>}<h3>{item.title}</h3><p>{item.detail}</p></div></article>)}</div>
      </Section>

      <Section id="contact" eyebrow="Get in touch" title="Contact">
        <div class="contact-panel"><div><p>I welcome conversations about research, teaching, and collaboration.</p><a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a></div><address><p><Icon name="location" />{site.location}</p><p>{site.institution}</p><p>{site.laboratory}</p></address></div>
      </Section>
    </div>
  </main>
  <footer><div><p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p><p>Last updated {updated} · Built with Astro</p></div><a href="#top">Back to top ↑</a></footer>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  {articleSchema.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
</BaseLayout>
